import os

import torch
import matplotlib.pyplot as plt

from model import Generator
from tester.classifier import Classifier


# =========================
# 기본 설정
# =========================

device = torch.device(
    "cuda" if torch.cuda.is_available() else "cpu"
)

noise_dim = 100
num_classes = 10


# =========================
# 경로 설정
# =========================

checkpoint_dir = "./checkpoint/checkpoint_Periodic"

output_dir = "./tester/C_test"

os.makedirs(
    output_dir,
    exist_ok=True
)


# =========================
# 확인할 Epoch
# =========================

epochs = sorted(
    int(
        filename.split("_")[1].split(".")[0]
    )
    for filename in os.listdir(checkpoint_dir)
    if filename.startswith("checkpoint_")
    and filename.endswith(".pth")
)

# epochs = [
#     10,
#     50,
#     100,
#     160,
#     240,
#     320,
#     400,
#     480
# ]


# =========================
# Generator
# =========================

generator = Generator(
    noise_dim=noise_dim,
    num_classes=num_classes
).to(device)


# =========================
# Classifier
# =========================

classifier = Classifier().to(device)

classifier.load_state_dict(
    torch.load(
        "./tester/classifier/classifier.pth",
        map_location=device
    )
)

classifier.eval()


# =========================
# 동일한 Noise 생성
# =========================

noise = torch.randn(
    num_classes,
    noise_dim,
    device=device
)


# =========================
# Label
# =========================

labels = torch.arange(
    num_classes,
    device=device
)


# =========================
# Checkpoint 평가
# =========================

for epoch in epochs:

    checkpoint_path = os.path.join(
        checkpoint_dir,
        f"checkpoint_{epoch}.pth"
    )

    if not os.path.exists(checkpoint_path):
        print(
            f"Checkpoint not found: {checkpoint_path}"
        )
        continue

    checkpoint = torch.load(
        checkpoint_path,
        map_location=device
    )

    generator.load_state_dict(
        checkpoint["generator_state_dict"]
    )

    generator.eval()

    with torch.no_grad():

        # 이미지 생성
        fake_images = generator(
            noise,
            labels
        )

        # Classifier 예측
        classifier_output = classifier(
            fake_images
        )

        predictions = torch.argmax(
            classifier_output,
            dim=1
        )

        probabilities = torch.softmax(
            classifier_output,
            dim=1
        )

        confidence = torch.max(
            probabilities,
            dim=1
        ).values

    # =========================
    # 결과 출력
    # =========================

    print(
        f"\nEpoch [{epoch}]"
    )

    for i in range(num_classes):

        print(
            f"Condition: {i} | "
            f"Prediction: {predictions[i].item()} | "
            f"Confidence: {confidence[i].item():.4f}"
        )

    # =========================
    # 이미지 출력
    # =========================

    figure, axes = plt.subplots(
        2,
        5,
        figsize=(12, 5)
    )

    axes = axes.flatten()

    for i in range(num_classes):

        image = fake_images[i].squeeze().cpu()

        axes[i].imshow(
            image,
            cmap="gray",
            vmin=-1,
            vmax=1
        )

        axes[i].set_title(
            f"Condition: {i}\n"
            f"Prediction: {predictions[i].item()}\n"
            f"Confidence: {confidence[i].item():.2f}"
        )

        axes[i].axis("off")

    figure.suptitle(
        f"Fifth - Epoch {epoch}"
    )

    plt.tight_layout()

    save_path = os.path.join(
        output_dir,
        f"epoch_{epoch}.png"
    )

    plt.savefig(
        save_path,
        dpi=150
    )

    plt.close()

    print(
        f"Saved: {save_path}"
    )